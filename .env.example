# Supabase is the only application backend. The secret key must remain
# server-only; never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Comma-separated bootstrap admins. Keep this server-only and use it to approve
# and assign roles to all subsequent accounts.
INITIAL_ADMIN_EMAILS=

# Durable website alerts are stored in Supabase. Resend delivers the matching
# email; use a sender on a domain verified in your Resend account.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=FRC 190 Manufacturing <manufacturing@example.com>

# Use http://localhost:3000 locally and the production Vercel origin when deployed.
NEXT_PUBLIC_APP_URL=http://localhost:3000

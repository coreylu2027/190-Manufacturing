# Baserow stays server-side. Never prefix the token with NEXT_PUBLIC_.
BASEROW_API_URL=https://api.baserow.io
BASEROW_API_TOKEN=
BASEROW_OPERATIONS_TABLE_ID=1169282
BASEROW_REQUIREMENTS_TABLE_ID=1119642
BASEROW_PARTS_TABLE_ID=1119641
BASEROW_FINISHING_TABLE_ID=1170619
# Extra comma-separated file hosts for self-hosted Baserow. Baserow Cloud file
# delivery from files.baserow.io and its production S3 buckets is automatic.
BASEROW_FILE_HOSTS=

# Supabase Auth (Google + Azure/Microsoft providers enabled in Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated bootstrap admins. Keep this server-only and use it to approve
# and assign roles to all subsequent accounts.
INITIAL_ADMIN_EMAILS=
REQUIRE_AUTH=false

# Durable website alerts are stored in Supabase. Resend delivers the matching
# email; use a sender on a domain verified in your Resend account.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=FRC 190 Manufacturing <manufacturing@example.com>

# Use http://localhost:3000 locally and the production Vercel origin when deployed.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Safe default. Set both values to supabase only after installing and enabling
# supabase/production/20260905_manufacturing_writes.sql as one coordinated cutover.
MANUFACTURING_READ_SOURCE=baserow
MANUFACTURING_WRITE_SOURCE=baserow
# Optional while Baserow is the read source; errors never replace its response.
MANUFACTURING_SHADOW_READS=false
